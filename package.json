{
  "name": "presence-io",
  "version": "0.1.0",
  "description": "Framework-agnostic Socket.io + Redis presence and room manager for TypeScript",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "type": "commonjs",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src tests --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:audit": "vitest run tests/audit --config vitest.integration.config.ts",
    "test:all": "npm run test && npm run test:integration",
    "test:watch": "vitest",
    "smoke:pack": "node scripts/smoke-pack.mjs",
    "prepublishOnly": "npm run typecheck && npm run lint && npm run test:all && npm run build && npm run smoke:pack"
  },
  "peerDependencies": {
    "ioredis": "^5.0.0",
    "socket.io": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "ioredis": "^5.4.1",
    "ioredis-mock": "^8.9.0",
    "prettier": "^3.2.5",
    "socket.io": "^4.7.5",
    "tsup": "^8.0.2",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  },
  "keywords": [
    "socket.io",
    "redis",
    "presence",
    "realtime",
    "typescript",
    "websocket"
  ],
  "license": "MIT",
  "author": "abhijadav",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abhijadav/presence-io.git"
  },
  "bugs": {
    "url": "https://github.com/abhijadav/presence-io/issues"
  },
  "homepage": "https://github.com/abhijadav/presence-io#readme",

  "engines": {
    "node": ">=18"
  }
}

